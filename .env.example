KIWIT_POSTGRES_PASSWORD=replace-with-a-long-random-password
KIWIT_DATABASE_URL=postgresql://kiwit_owner:replace-with-a-long-random-password@127.0.0.1:5432/kiwit
KIWIT_DB_CONNECT_TIMEOUT=10
KIWIT_GROWW_ACCESS_TOKEN=replace-with-daily-access-token
KIWIT_BROKER_TIMEOUT_SECONDS=8
OPENAI_API_KEY=
KIWIT_BANKNIFTY_AI_ENABLED=false
# Comma-separated alert recipients. Configure an SMTP sender before enabling email alerts.
KIWIT_ALERT_EMAIL=operator@example.com,backup@example.com
KIWIT_SMTP_HOST=smtp.example.com
KIWIT_SMTP_PORT=465
KIWIT_SMTP_IMPLICIT_TLS=true
KIWIT_SMTP_USERNAME=
KIWIT_SMTP_PASSWORD=
KIWIT_EMAIL_FROM=
